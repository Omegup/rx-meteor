{
  "compilerOptions": {
    "baseUrl": ".",
    "downlevelIteration": true,
    "module": "es2020",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strictFunctionTypes": true,
    "strict": true,
    "lib": [
      "es2020",
    ]
  },
  "include": [
    "."
  ],
  "exclude": [
    "node_modules"
  ]
}